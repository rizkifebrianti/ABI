                  ${!existing || existing.showExplanation ? 'checked' : ''}
                  class="rounded text-indigo-600"
                />
                Tampilkan kunci jawaban &amp; pembahasan pada halaman hasil siswa
              </label>

              <div class="flex justify-end gap-2.5 pt-3 border-t border-slate-100">
