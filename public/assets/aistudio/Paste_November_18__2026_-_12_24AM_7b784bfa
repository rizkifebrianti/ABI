                      class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm font-mono uppercase"
                    />
                    <button
                      type="button"
                      onclick="document.getElementById('pkg-form-token').value = app.generateRandomToken()"
                      class="px-3 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-xs font-bold border border-slate-300"
                      title="Acak Token"
                    >
                      🎲
                    </button>
                  </div>
                </div>

                <div>
                  <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Status Publikasi</label>
                  <select id="pkg-form-status" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm font-semibold bg-white">
                    <option value="Published" ${!existing || existing.status === 'Published' ? 'selected' : ''}>Published (Tampil di Siswa)</option>
                    <option value="Draft" ${existing && existing.status === 'Draft' ? 'selected' : ''}>Draft (Disembunyikan)</option>
                    <option value="Closed" ${existing && existing.status === 'Closed' ? 'selected' : ''}>Closed (Ditutup)</option>
