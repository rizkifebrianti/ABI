      cancelImportPreview() {
        this.importedPreviewQuestions = [];
        const section = document.getElementById('import-preview-section');
        if (section) section.classList.add('hidden');
      }

      confirmSaveImportedQuestions() {
        if (!this.importedPreviewQuestions || this.importedPreviewQuestions.length === 0) return;
        const mode = document.querySelector('input[name="import-target-mode"]:checked')?.value || 'new';

        if (mode === 'existing') {
          const targetId = document.getElementById('imp-existing-pkg-select').value;
          const pkg = this.packages.find((p) => p.id === targetId);
          if (!pkg) {
            this.showToast('Pilih paket tujuan terlebih dahulu.', 'error');
            return;
          }
          if (!Array.isArray(pkg.questions)) pkg.questions = [];
          pkg.questions.push(...this.importedPreviewQuestions);
          this.persistPackage(pkg);
          this.showToast(`${this.importedPreviewQuestions.length} soal berhasil ditambahkan ke paket "${pkg.title}".`, 'success');
        } else {
          const title = document.getElementById('imp-pkg-title').value.trim();
          const category = document.getElementById('imp-pkg-category').value;
          const duration = Math.max(1, parseInt(document.getElementById('imp-pkg-duration').value, 10) || 30);
          const token = document.getElementById('imp-pkg-token').value.trim().toUpperCase() || this.generateRandomToken();
          const status = document.getElementById('imp-pkg-status').value;
          const showExplanation = document.getElementById('imp-pkg-explanation').checked;

          if (!title) {
            this.showToast('Judul paket soal baru wajib diisi!', 'error');
            return;
          }

          const newPkg = {
            id: 'pkg-' + Date.now(),
            title,
            category,
            duration,
            token,
            status,
            showExplanation,
            createdAt: new Date().toISOString(),
            questions: [...this.importedPreviewQuestions]
          };
          this.persistPackage(newPkg);
          this.showToast(`Paket baru "${title}" berisi ${newPkg.questions.length} soal berhasil disimpan!`, 'success');
        }

        this.cancelImportPreview();
        this.setAdminTab('packages');
      }

