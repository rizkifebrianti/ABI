            'Kunci Jawaban': 'C',
            'Pembahasan': 'Bentuk baku dalam KBBI adalah <b>diagnosis</b>, <i>apotek</i>, <i>analisis</i>, <i>risiko</i>, dan <i>praktik</i>.'
          }
