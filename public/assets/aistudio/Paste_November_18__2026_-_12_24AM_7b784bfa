                      <strong class="text-slate-900">${qCount} Soal</strong>
                    </div>
                    <div class="flex justify-between">
                      <span class="text-slate-500">Durasi Ujian:</span>
                      <strong class="text-slate-900">${pkg.duration} Menit</strong>
                    </div>
                    <div class="flex justify-between items-center">
                      <span class="text-slate-500">Token Kuis:</span>
                      <code class="px-2 py-0.5 rounded bg-slate-900 text-amber-300 font-mono font-bold">${escapeHtmlText(pkg.token)}</code>
                    </div>
                  </div>
                </div>

                <div class="space-y-2 pt-2 border-t border-slate-100">
                  <button
                    type="button"
                    onclick="app.openQuestionManager('${pkg.id}')"
                    class="w-full py-2.5 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs sm:text-sm font-bold shadow-2xs transition"
                  >
                    ✍️ Kelola Butir Soal (${qCount})
                  </button>
                  <div class="grid grid-cols-2 gap-2">
                    <button
                      type="button"
                      onclick="app.openPackageFormModal('${pkg.id}')"
