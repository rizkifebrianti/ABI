                </div>

                <div>
                  <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Durasi (Menit)</label>
                  <input
                    id="pkg-form-duration"
                    type="number"
                    min="1"
                    max="300"
                    required
                    value="${existing ? existing.duration : 30}"
                    class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Token Kuis</label>
                  <div class="flex gap-1.5">
