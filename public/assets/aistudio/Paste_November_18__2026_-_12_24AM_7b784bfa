        const mode = document.querySelector('input[name="import-target-mode"]:checked')?.value || 'new';
        const newFields = document.getElementById('import-new-pkg-fields');
        const extFields = document.getElementById('import-existing-pkg-fields');
        if (mode === 'new') {
          newFields.classList.remove('hidden');
          extFields.classList.add('hidden');
        } else {
