                    >
                      <option value="Published" ${pkg.status === 'Published' ? 'selected' : ''}>Published</option>
                      <option value="Draft" ${pkg.status === 'Draft' ? 'selected' : ''}>Draft</option>
                      <option value="Closed" ${pkg.status === 'Closed' ? 'selected' : ''}>Closed</option>
                    </select>
                  </div>

                  <h3 class="font-extrabold text-base text-slate-900 leading-snug mb-3">
                    ${escapeHtmlText(pkg.title)}
                  </h3>

