    // ==================== 2. SANITIZER & HELPER FORMAT EJAAN ====================
    function sanitizeFormattedHtml(rawHtml) {
      if (rawHtml === null || rawHtml === undefined) return '';
      const str = String(rawHtml).trim();
      if (!str) return '';

      const template = document.createElement('template');
      template.innerHTML = str;

      const allowedTags = new Set([
        'B', 'STRONG', 'I', 'EM', 'U', 'P', 'BR', 'UL', 'OL', 'LI', 'SPAN', 'DIV'
      ]);

      const cleanNode = (parent) => {
        const children = Array.from(parent.childNodes);
        for (const node of children) {
          if (node.nodeType === Node.ELEMENT_NODE) {
            const tag = node.tagName.toUpperCase();
            if (!allowedTags.has(tag)) {
              // Ganti tag tidak diizinkan dengan isinya saja (kecuali script/style)
              if (tag === 'SCRIPT' || tag === 'STYLE') {
                node.remove();
              } else {
                const frag = document.createDocumentFragment();
                while (node.firstChild) {
                  frag.appendChild(node.firstChild);
                }
                parent.replaceChild(frag, node);
                cleanNode(parent);
              }
            } else {
              // Hapus semua atribut berbahaya (seperti onclick, onerror, style bebas)
              Array.from(node.attributes).forEach((attr) => {
                node.removeAttribute(attr.name);
              });
              cleanNode(node);
            }
          }
        }
      };

      cleanNode(template.content);
      return template.innerHTML.trim();
    }

    function stripHtmlToText(html) {
      const div = document.createElement('div');
      div.innerHTML = html || '';
      return (div.textContent || div.innerText || '').trim();
    }

    function escapeHtmlText(str) {
      return String(str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

