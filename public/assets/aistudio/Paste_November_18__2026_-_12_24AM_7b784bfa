      loadFromLocalStorage(key, fallbackData) {
        try {
          const raw = localStorage.getItem(key);
          if (raw) {
            const parsed = JSON.parse(raw);
            if (Array.isArray(parsed)) return parsed;
          }
        } catch (err) {
          console.warn('Gagal membaca LocalStorage:', err);
        }
        const seeded = JSON.parse(JSON.stringify(fallbackData));
        this.saveToLocalStorage(key, seeded);
        return seeded;
      }

      saveToLocalStorage(key, data) {
        try {
          localStorage.setItem(key, JSON.stringify(data));
        } catch (err) {
          console.warn('Gagal menyimpan ke LocalStorage:', err);
        }
      }

      init() {
        this.initRichTextEditors();
        this.renderPortal();
        const activeUrl = this.getActiveFirebaseUrl();
        if (activeUrl) {
          this.updateCloudStatusBadge('syncing', 'Menyinkronkan...');
          this.syncFromCloud(false);
        } else {
          this.updateCloudStatusBadge('local', 'Mode Lokal');
        }
      }

      // ==================== 3B. SINKRONISASI FIREBASE REALTIME DATABASE ====================
      getActiveFirebaseUrl() {
        const stored = (localStorage.getItem(STORAGE_KEYS.FIREBASE_URL) || '').trim();
        const raw = stored || (DEFAULT_FIREBASE_URL || '').trim();
        return raw.replace(/\/+$/, '');
      }

      normalizeFirebaseList(rawData) {
        if (!rawData) return [];
        const list = Array.isArray(rawData) ? rawData : Object.values(rawData);
        return list.filter(Boolean).map((pkg) => {
          const normalizedQuestions = Array.isArray(pkg.questions)
            ? pkg.questions.filter(Boolean)
            : pkg.questions && typeof pkg.questions === 'object'
            ? Object.values(pkg.questions).filter(Boolean)
            : [];
          return {
            ...pkg,
            questions: normalizedQuestions
          };
        });
      }

      updateCloudStatusBadge(state, labelText = '') {
        const badge = document.getElementById('db-status-badge');
        const dot = document.getElementById('db-status-dot');
        const textEl = document.getElementById('db-status-text');
        if (!badge || !dot || !textEl) return;

        if (state === 'connected') {
          this.isCloudConnected = true;
          badge.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] sm:text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200';
          dot.className = 'w-2 h-2 rounded-full bg-emerald-500';
          textEl.textContent = labelText || 'Cloud Terhubung';
        } else if (state === 'syncing') {
          badge.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] sm:text-xs font-semibold bg-amber-50 text-amber-800 border border-amber-200';
          dot.className = 'w-2 h-2 rounded-full bg-amber-500 animate-ping';
          textEl.textContent = labelText || 'Menyinkronkan...';
        } else {
          this.isCloudConnected = false;
          badge.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] sm:text-xs font-semibold bg-slate-100 text-slate-700 border border-slate-200';
          dot.className = 'w-2 h-2 rounded-full bg-slate-400';
          textEl.textContent = labelText || 'Mode Lokal';
        }
      }

      async syncFromCloud(manualNotify = false) {
        const dbUrl = this.getActiveFirebaseUrl();
        const refreshIcon = document.getElementById('icon-refresh-portal');
        if (refreshIcon) refreshIcon.classList.add('animate-spin');

        if (!dbUrl) {
          this.updateCloudStatusBadge('local', 'Mode Lokal');
          this.renderPortal();
          if (refreshIcon) refreshIcon.classList.remove('animate-spin');
          if (manualNotify) {
            this.showToast('Aplikasi berjalan dalam Mode Lokal. Daftar paket dimuat ulang.', 'info');
          }
          return false;
        }

        try {
          const response = await fetch(`${dbUrl}/packages.json`, { cache: 'no-store' });
          if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
          }
          const data = await response.json();
          const cloudPackages = this.normalizeFirebaseList(data);

          if (cloudPackages.length > 0) {
            this.packages = cloudPackages;
            this.saveToLocalStorage(STORAGE_KEYS.PACKAGES, this.packages);
          }

          this.lastCloudSync = new Date().toISOString();
          this.updateCloudStatusBadge('connected', 'Cloud Terhubung');
          this.renderPortal();
          if (this.isAdminAuthenticated && this.adminActiveTab === 'packages' && !this.managingPackageId) {
            this.renderAdminPackages();
          }

          if (manualNotify) {
            this.showToast('Daftar paket soal berhasil disinkronkan dari Cloud!', 'success');
          }
          return true;
        } catch (err) {
          console.warn('Gagal menyinkronkan dari Firebase, menggunakan fallback LocalStorage:', err);
          this.updateCloudStatusBadge('local', 'Mode Lokal');
          this.renderPortal();
          if (manualNotify) {
            this.showToast('Gagal terhubung ke Cloud. Menggunakan data tersimpan lokal.', 'warning');
          }
          return false;
        } finally {
          if (refreshIcon) refreshIcon.classList.remove('animate-spin');
        }
      }

      async pushPackagesToCloud(manualNotify = false) {
        const dbUrl = this.getActiveFirebaseUrl();
        if (!dbUrl) return false;

        try {
          const response = await fetch(`${dbUrl}/packages.json`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(this.packages)
          });
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          this.lastCloudSync = new Date().toISOString();
          this.updateCloudStatusBadge('connected', 'Cloud Terhubung');
          if (manualNotify) {
            this.showToast('Bank soal berhasil disimpan ke Firebase Cloud!', 'success');
          }
          return true;
        } catch (err) {
          console.warn('Gagal mengunggah paket ke Firebase:', err);
          this.updateCloudStatusBadge('local', 'Mode Lokal');
          if (manualNotify) {
            this.showToast('Tersimpan lokal, namun gagal mengirim ke Cloud.', 'warning');
          }
          return false;
        }
      }

      async pushResultToCloud(resultObj) {
        const dbUrl = this.getActiveFirebaseUrl();
        if (!dbUrl) return false;

        try {
          const payload = { ...resultObj };
          delete payload._firebaseKey;
          const response = await fetch(`${dbUrl}/results.json`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          const resJson = await response.json();
          if (resJson && resJson.name) {
            const idx = this.results.findIndex((r) => r.id === resultObj.id);
            if (idx >= 0) {
              this.results[idx]._firebaseKey = resJson.name;
              this.saveToLocalStorage(STORAGE_KEYS.RESULTS, this.results);
            }
          }
          this.updateCloudStatusBadge('connected', 'Cloud Terhubung');
          return true;
        } catch (err) {
          console.warn('Gagal mengirim nilai siswa ke Firebase:', err);
          return false;
        }
      }

      async fetchResultsFromCloud(manualNotify = false) {
        const dbUrl = this.getActiveFirebaseUrl();
        if (!dbUrl) {
          if (manualNotify) {
            this.showToast('Database Cloud belum diatur. Menampilkan data nilai dari penyimpanan lokal.', 'info');
          }
          this.renderScoresAdminView();
          return false;
        }

        try {
          const response = await fetch(`${dbUrl}/results.json`, { cache: 'no-store' });
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          const raw = await response.json();

          if (raw && typeof raw === 'object') {
            const cloudEntries = Object.entries(raw)
              .filter(([, val]) => val && typeof val === 'object')
              .map(([fbKey, val]) => ({
                ...val,
                _firebaseKey: fbKey
              }));

            const mergedMap = new Map();
            this.results.forEach((item) => {
              if (item && item.id) mergedMap.set(item.id, item);
            });
            cloudEntries.forEach((item) => {
              if (item && item.id) {
                mergedMap.set(item.id, item);
              }
            });

            this.results = Array.from(mergedMap.values()).sort(
              (a, b) => new Date(b.finishedAt || 0) - new Date(a.finishedAt || 0)
            );
            this.saveToLocalStorage(STORAGE_KEYS.RESULTS, this.results);
          }

          this.updateCloudStatusBadge('connected', 'Cloud Terhubung');
          this.renderScoresAdminView();
          if (manualNotify) {
            this.showToast('Rekap nilai & pelanggaran siswa berhasil disinkronkan dari Cloud!', 'success');
          }
          return true;
        } catch (err) {
          console.warn('Gagal mengambil rekap nilai dari Firebase:', err);
          if (manualNotify) {
            this.showToast('Gagal mengambil data nilai terbaru dari Cloud.', 'warning');
          }
          this.renderScoresAdminView();
          return false;
        }
      }

      persistPackage(pkg, skipCloudSync = false) {
        const idx = this.packages.findIndex((p) => p.id === pkg.id);
        if (idx >= 0) {
          this.packages[idx] = pkg;
        } else {
          this.packages.unshift(pkg);
        }
        this.saveToLocalStorage(STORAGE_KEYS.PACKAGES, this.packages);
        if (!skipCloudSync) {
          this.pushPackagesToCloud(false);
        }
      }

      removePackageFromDb(pkgId) {
        this.packages = this.packages.filter((p) => p.id !== pkgId);
        this.saveToLocalStorage(STORAGE_KEYS.PACKAGES, this.packages);
        this.pushPackagesToCloud(false);
      }

      persistResult(resultObj) {
        this.results.unshift(resultObj);
        this.saveToLocalStorage(STORAGE_KEYS.RESULTS, this.results);
        this.pushResultToCloud(resultObj);
      }

      removeResultFromDb(resId) {
        const target = this.results.find((r) => r.id === resId);
        this.results = this.results.filter((r) => r.id !== resId);
        this.saveToLocalStorage(STORAGE_KEYS.RESULTS, this.results);

        const dbUrl = this.getActiveFirebaseUrl();
        if (dbUrl && target && target._firebaseKey) {
          fetch(`${dbUrl}/results/${target._firebaseKey}.json`, { method: 'DELETE' }).catch(() => {});
        }
      }

      // ==================== 4. UI UTILITIES (MODAL, TOAST, VIEW SWITCHER) ====================
      switchView(viewName) {
        const views = ['portal', 'exam', 'result', 'admin'];
        views.forEach((v) => {
          const el = document.getElementById(`view-${v}`);
          if (el) {
            if (v === viewName) {
              el.classList.remove('hidden');
              if (v === 'exam') el.classList.add('flex');
            } else {
              el.classList.add('hidden');
              el.classList.remove('flex');
            }
          }
        });

        const nav = document.getElementById('main-navbar');
        const footer = document.getElementById('main-footer');
        if (viewName === 'exam') {
          nav.classList.add('hidden');
          footer.classList.add('hidden');
        } else {
          nav.classList.remove('hidden');
          footer.classList.remove('hidden');
        }

        const adminBtnText = document.getElementById('btn-admin-nav-text');
        adminBtnText.textContent = this.isAdminAuthenticated ? 'Dashboard Admin' : 'Login Admin';

        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      navigateHome() {
        this.cleanupExamSecurity();
        if (this.activeExam && this.activeExam.timerId) {
          clearInterval(this.activeExam.timerId);
          this.activeExam = null;
        }
        this.switchView('portal');
        this.renderPortal();
        if (this.getActiveFirebaseUrl()) {
          this.syncFromCloud(false);
        }
      }

      openModal(htmlContent) {
        const backdrop = document.getElementById('modal-backdrop');
        const box = document.getElementById('modal-box');
        if (!backdrop || !box) return;
        box.innerHTML = htmlContent;
        backdrop.classList.remove('hidden');
        backdrop.classList.add('flex');
      }

      closeModal() {
        const backdrop = document.getElementById('modal-backdrop');
        const box = document.getElementById('modal-box');
        if (!backdrop || !box) return;
        backdrop.classList.add('hidden');
        backdrop.classList.remove('flex');
        box.innerHTML = '';
      }

      showToast(message, type = 'info') {
        const container = document.getElementById('toast-container');
        if (!container) return;

        const styles = {
          success: 'bg-emerald-900 text-white border-emerald-700',
          error: 'bg-rose-900 text-white border-rose-700',
          warning: 'bg-amber-900 text-white border-amber-700',
          info: 'bg-slate-900 text-white border-slate-700'
        };
        const icons = {
          success: '✓',
          error: '✕',
          warning: '⚠️',
          info: 'ℹ️'
        };

        const toast = document.createElement('div');
        toast.className = `pointer-events-auto rounded-xl px-4 py-3 text-xs sm:text-sm font-semibold shadow-lg border flex items-center gap-2.5 animate-fade-in ${styles[type] || styles.info}`;
        toast.innerHTML = `
          <span class="shrink-0 font-bold">${icons[type] || icons.info}</span>
          <span class="flex-1 leading-snug">${escapeHtmlText(message)}</span>
        `;
        container.appendChild(toast);

        setTimeout(() => {
          toast.style.opacity = '0';
          toast.style.transition = 'opacity 0.25s ease';
          setTimeout(() => toast.remove(), 260);
        }, 3800);
      }

      // ==================== 5. PORTAL SISWA (KATALOG & VERIFIKASI TOKEN) ====================
      setPortalSearch(query) {
