      verifyAndStartExam(event, pkgId) {
        event.preventDefault();
        const pkg = this.packages.find((p) => p.id === pkgId && p.status === 'Published');
        if (!pkg) return;

        const studentName = document.getElementById('student-login-name').value.trim();
        const studentClass = document.getElementById('student-login-class').value.trim();
        const inputToken = document.getElementById('student-login-token').value.trim().toUpperCase();
        const errBox = document.getElementById('student-login-error');

        if (!studentName || !studentClass || !inputToken) {
          errBox.textContent = 'Nama lengkap, kelas, dan token kuis wajib diisi!';
          errBox.classList.remove('hidden');
          return;
        }

        if (inputToken !== (pkg.token || '').trim().toUpperCase()) {
          errBox.textContent = 'Token kuis tidak cocok! Periksa kembali huruf/angka token dari tutor.';
          errBox.classList.remove('hidden');
          return;
        }

        this.closeModal();
        this.startExam(pkg, studentName, studentClass);
      }

      // ==================== 6. RUANG UJIAN CAT & SISTEM ANTI-NYONTEK ====================
      startExam(pkg, studentName, studentClass) {
        this.cleanupExamSecurity();
        const totalSeconds = Math.max(1, Number(pkg.duration || 30)) * 60;

        this.activeExam = {
          pkg: JSON.parse(JSON.stringify(pkg)),
          studentName,
          studentClass,
          currentIndex: 0,
          answers: {},
          doubts: {},
          fontSize: 16,
          mobileTab: 'passage',
          totalSeconds,
          remainingSeconds: totalSeconds,
          timerId: null,
          violationCount: 0,
          lastViolationAt: 0,
          isBanned: false
        };

        document.getElementById('exam-category-badge').textContent = pkg.category;
        document.getElementById('exam-package-title').textContent = pkg.title;
        document.getElementById('exam-student-name').textContent = studentName;
        document.getElementById('exam-student-class').textContent = studentClass;
        document.getElementById('exam-q-total').textContent = pkg.questions.length;
        document.getElementById('exam-font-label').textContent = '100%';

        this.updateViolationBadgeUI();
        this.switchView('exam');
        this.renderExamQuestion();
        this.startExamTimer();
        this.setupExamSecurity();
      }

      setupExamSecurity() {
        this.cleanupExamSecurity();

        this._boundVisibilityHandler = () => {
          if (document.hidden && this.activeExam && !this.activeExam.isBanned) {
            this.registerCheatingViolation('Terdeteksi berpindah tab browser atau menyembunyikan layar ujian.');
          }
        };

        this._boundBlurHandler = () => {
          if (this.activeExam && !this.activeExam.isBanned) {
            this.registerCheatingViolation('Terdeteksi meninggalkan jendela ujian atau membuka aplikasi lain.');
          }
        };

        this._boundContextMenuHandler = (e) => {
          if (this.activeExam) {
            e.preventDefault();
            this.showToast('Klik kanan dinonaktifkan selama ujian berlangsung.', 'warning');
          }
        };

        this._boundCopyCutHandler = (e) => {
          if (this.activeExam) {
            e.preventDefault();
            this.showToast('Menyalin atau memotong teks soal tidak diperbolehkan.', 'warning');
          }
        };

        document.addEventListener('visibilitychange', this._boundVisibilityHandler);
        window.addEventListener('blur', this._boundBlurHandler);
        document.addEventListener('contextmenu', this._boundContextMenuHandler);
        document.addEventListener('copy', this._boundCopyCutHandler);
        document.addEventListener('cut', this._boundCopyCutHandler);
      }

      cleanupExamSecurity() {
        if (this._boundVisibilityHandler) {
          document.removeEventListener('visibilitychange', this._boundVisibilityHandler);
          this._boundVisibilityHandler = null;
        }
        if (this._boundBlurHandler) {
          window.removeEventListener('blur', this._boundBlurHandler);
          this._boundBlurHandler = null;
        }
        if (this._boundContextMenuHandler) {
          document.removeEventListener('contextmenu', this._boundContextMenuHandler);
          this._boundContextMenuHandler = null;
        }
        if (this._boundCopyCutHandler) {
          document.removeEventListener('copy', this._boundCopyCutHandler);
          document.removeEventListener('cut', this._boundCopyCutHandler);
          this._boundCopyCutHandler = null;
        }
      }

      updateViolationBadgeUI() {
        if (!this.activeExam) return;
        const count = this.activeExam.violationCount;
        const badge = document.getElementById('exam-violation-badge');
        const countEl = document.getElementById('exam-violation-count');
        if (!badge || !countEl) return;

        countEl.textContent = `${count}/3`;
        if (count === 0) {
          badge.className = 'inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs font-bold';
        } else if (count === 1) {
          badge.className = 'inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl bg-amber-100 text-amber-900 border border-amber-300 text-xs font-bold';
        } else {
          badge.className = 'inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl bg-rose-100 text-rose-800 border border-rose-300 text-xs font-bold animate-pulse';
        }
      }

      registerCheatingViolation(reason) {
        if (!this.activeExam || this.activeExam.isBanned) return;

        const now = Date.now();
        // Cooldown 1500ms agar visibilitychange & blur tidak terhitung ganda pada satu kejadian
        if (now - this.activeExam.lastViolationAt < 1500) return;
        this.activeExam.lastViolationAt = now;

        this.activeExam.violationCount += 1;
        const count = this.activeExam.violationCount;
        this.updateViolationBadgeUI();

        if (count >= 3) {
          this.activeExam.isBanned = true;
          this.closeModal();
          this.showToast('Pelanggaran ke-3 terdeteksi! Ujian otomatis dibanned dan dikumpulkan.', 'error');
          this.finishExam(true);
          return;
        }

        const remaining = 3 - count;
        this.openModal(`
          <div class="p-6 space-y-4">
            <div class="flex items-center gap-3 text-rose-700 border-b border-rose-100 pb-3">
              <div class="w-11 h-11 rounded-2xl bg-rose-100 flex items-center justify-center text-2xl shrink-0">🚨</div>
              <div>
                <span class="text-xs font-extrabold uppercase tracking-wider text-rose-600 block">Peringatan Anti-Nyontek (${count}/3)</span>
                <h3 class="text-base sm:text-lg font-extrabold text-slate-900">Pelanggaran Fokus Layar Terdeteksi!</h3>
              </div>
            </div>

            <p class="text-sm text-slate-700 leading-relaxed">
              ${escapeHtmlText(reason)}
            </p>

            <div class="rounded-xl bg-amber-50 border border-amber-200 p-3.5 text-xs text-amber-950 leading-relaxed">
              Sisa toleransi Anda tinggal <strong>${remaining} kali</strong>. Jika mencapai <strong>3 kali pelanggaran</strong>, ujian akan langsung dihentikan (<strong>BANNED</strong>) dan jawaban Anda dikumpulkan otomatis.
            </div>

            <div class="flex justify-end pt-2">
              <button type="button" onclick="app.closeModal()" class="px-5 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-sm font-bold shadow-xs transition">
                Saya Mengerti &amp; Lanjutkan Ujian
              </button>
            </div>
          </div>
        `);
      }

      startExamTimer() {
        if (!this.activeExam) return;
        if (this.activeExam.timerId) clearInterval(this.activeExam.timerId);

        this.updateTimerUI();
        this.activeExam.timerId = setInterval(() => {
          if (!this.activeExam) return;
          this.activeExam.remainingSeconds -= 1;

          if (this.activeExam.remainingSeconds <= 0) {
            this.activeExam.remainingSeconds = 0;
            this.updateTimerUI();
            clearInterval(this.activeExam.timerId);
            this.showToast('Waktu pengerjaan telah habis! Jawaban otomatis dikumpulkan.', 'warning');
            this.finishExam(false);
            return;
          }

          this.updateTimerUI();
        }, 1000);
      }

      updateTimerUI() {
        if (!this.activeExam) return;
        const sec = Math.max(0, this.activeExam.remainingSeconds);
        const mins = Math.floor(sec / 60);
        const remSec = sec % 60;
        const text = `${String(mins).padStart(2, '0')}:${String(remSec).padStart(2, '0')}`;

        const timerText = document.getElementById('exam-timer-text');
        const timerBox = document.getElementById('exam-timer-box');
        if (timerText) timerText.textContent = text;

        if (timerBox) {
          if (sec <= 60) {
            timerBox.className = 'inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-rose-600 text-white font-mono text-sm font-bold shadow-2xs animate-pulse';
          } else {
            timerBox.className = 'inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-900 text-white font-mono text-sm font-bold shadow-2xs';
          }
        }
      }

      adjustFontSize(delta) {
        if (!this.activeExam) return;
        const nextSize = Math.min(22, Math.max(13, this.activeExam.fontSize + delta));
        this.activeExam.fontSize = nextSize;
        const pct = Math.round((nextSize / 16) * 100);
        const label = document.getElementById('exam-font-label');
        if (label) label.textContent = `${pct}%`;

        const passageEl = document.getElementById('exam-passage-content');
        const questionEl = document.getElementById('exam-question-text');
        const optionsEl = document.getElementById('exam-options-list');
        if (passageEl) passageEl.style.fontSize = `${nextSize}px`;
        if (questionEl) questionEl.style.fontSize = `${nextSize}px`;
        if (optionsEl) optionsEl.style.fontSize = `${Math.max(13, nextSize - 1)}px`;
      }

      setMobileExamTab(tab) {
        if (!this.activeExam) return;
        this.activeExam.mobileTab = tab;
        const passagePanel = document.getElementById('exam-passage-panel');
        const questionPanel = document.getElementById('exam-question-panel');
        const btnPassage = document.getElementById('tab-mobile-passage');
        const btnQuestion = document.getElementById('tab-mobile-question');

        if (!passagePanel || !questionPanel) return;

        if (tab === 'passage') {
          passagePanel.classList.remove('hidden');
          questionPanel.classList.add('hidden', 'lg:flex');
          if (btnPassage) btnPassage.className = 'py-2 px-3 rounded-xl text-xs font-bold bg-indigo-600 text-white shadow-2xs transition';
          if (btnQuestion) btnQuestion.className = 'py-2 px-3 rounded-xl text-xs font-bold bg-white text-slate-700 border border-slate-300 transition';
        } else {
          passagePanel.classList.add('hidden', 'lg:flex');
          questionPanel.classList.remove('hidden');
          if (btnPassage) btnPassage.className = 'py-2 px-3 rounded-xl text-xs font-bold bg-white text-slate-700 border border-slate-300 transition';
          if (btnQuestion) btnQuestion.className = 'py-2 px-3 rounded-xl text-xs font-bold bg-indigo-600 text-white shadow-2xs transition';
        }
      }

      renderExamQuestion() {
        if (!this.activeExam) return;
        const { pkg, currentIndex, answers, doubts, fontSize } = this.activeExam;
        const questions = pkg.questions || [];
        const q = questions[currentIndex];
        if (!q) return;

        document.getElementById('exam-q-number').textContent = currentIndex + 1;

        const hasPassage = Boolean(stripHtmlToText(q.passage));
        const passagePanel = document.getElementById('exam-passage-panel');
        const questionPanel = document.getElementById('exam-question-panel');
        const mobileTabs = document.getElementById('exam-mobile-tabs');

        if (hasPassage) {
          passagePanel.classList.remove('hidden');
          passagePanel.classList.add('flex');
          questionPanel.classList.remove('lg:col-span-12');
          questionPanel.classList.add('lg:col-span-6');
          if (mobileTabs) mobileTabs.classList.remove('hidden');

          const passageContent = document.getElementById('exam-passage-content');
          passageContent.innerHTML = sanitizeFormattedHtml(q.passage);
          passageContent.style.fontSize = `${fontSize}px`;
          passageContent.scrollTop = 0;

          if (window.innerWidth < 1024) {
            this.setMobileExamTab(this.activeExam.mobileTab || 'passage');
          } else {
            passagePanel.classList.remove('hidden');
            questionPanel.classList.remove('hidden');
          }
        } else {
          passagePanel.classList.add('hidden');
          passagePanel.classList.remove('flex');
          questionPanel.classList.remove('hidden', 'lg:col-span-6');
          questionPanel.classList.add('lg:col-span-12', 'flex');
          if (mobileTabs) mobileTabs.classList.add('hidden');
        }

        const qTextEl = document.getElementById('exam-question-text');
        qTextEl.innerHTML = sanitizeFormattedHtml(q.question);
        qTextEl.style.fontSize = `${fontSize}px`;

        const selectedOpt = answers[q.id] || null;
        const optKeys = ['A', 'B', 'C', 'D', 'E'].filter((key) => {
          if (key !== 'E') return true;
          return Boolean(stripHtmlToText(q.options && q.options.E));
        });

        const optionsList = document.getElementById('exam-options-list');
        optionsList.style.fontSize = `${Math.max(13, fontSize - 1)}px`;
        optionsList.innerHTML = optKeys
          .map((key) => {
            const isSelected = selectedOpt === key;
            const rawOpt = (q.options && q.options[key]) || '';
            return `
              <button
                type="button"
                onclick="app.selectOption('${key}')"
                class="w-full text-left p-3.5 sm:p-4 rounded-2xl border-2 transition flex items-start gap-3.5 ${
                  isSelected
                    ? 'border-indigo-600 bg-indigo-50/70 shadow-2xs'
                    : 'border-slate-200 bg-white hover:border-indigo-300 hover:bg-slate-50'
                }"
              >
                <span class="w-8 h-8 rounded-xl flex items-center justify-center text-xs sm:text-sm font-extrabold shrink-0 transition ${
                  isSelected
                    ? 'bg-indigo-600 text-white'
                    : 'bg-slate-100 text-slate-700'
                }">
                  ${key}
                </span>
                <span class="formatted-content flex-1 pt-0.5 text-slate-800 leading-relaxed">
                  ${sanitizeFormattedHtml(rawOpt)}
                </span>
              </button>
            `;
          })
          .join('');

        // Update tombol Ragu-ragu
        const isDoubt = Boolean(doubts[q.id]);
        const doubtBtn = document.getElementById('btn-toggle-doubt');
        const doubtIcon = document.getElementById('doubt-checkbox-icon');
        if (doubtBtn && doubtIcon) {
          if (isDoubt) {
            doubtIcon.textContent = '☑';
            doubtBtn.className = 'inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold border border-amber-500 bg-amber-400 text-slate-900 shadow-2xs transition';
          } else {
            doubtIcon.textContent = '☐';
            doubtBtn.className = 'inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold border border-amber-300 bg-amber-50 text-amber-800 hover:bg-amber-100 transition';
          }
        }

        // Update tombol Sebelumnya / Selanjutnya
        const prevBtn = document.getElementById('btn-exam-prev');
        const nextBtn = document.getElementById('btn-exam-next');
        if (prevBtn) prevBtn.disabled = currentIndex === 0;
        if (nextBtn) {
          if (currentIndex === questions.length - 1) {
            nextBtn.textContent = 'Selesai & Kumpulkan ✓';
            nextBtn.className = 'inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold bg-emerald-600 hover:bg-emerald-700 text-white shadow-2xs transition';
          } else {
            nextBtn.textContent = 'Selanjutnya →';
            nextBtn.className = 'inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold bg-indigo-600 hover:bg-indigo-700 text-white shadow-2xs transition';
          }
        }

        this.renderExamNavGrid();
      }

      renderExamNavGrid() {
        if (!this.activeExam) return;
        const { pkg, currentIndex, answers, doubts } = this.activeExam;
        const questions = pkg.questions || [];

        const answeredCount = questions.filter((q) => Boolean(answers[q.id])).length;
        const summaryEl = document.getElementById('exam-answered-summary');
        if (summaryEl) summaryEl.textContent = `${answeredCount}/${questions.length}`;

        const gridEl = document.getElementById('exam-nav-grid');
        if (!gridEl) return;

        gridEl.innerHTML = questions
          .map((q, idx) => {
            const isCurrent = idx === currentIndex;
            const isDoubt = Boolean(doubts[q.id]);
            const isAnswered = Boolean(answers[q.id]);

            let colorClass = 'bg-white text-slate-700 border-slate-300 hover:bg-slate-50';
            if (isDoubt) {
              colorClass = 'bg-amber-400 text-slate-900 border-amber-500';
            } else if (isAnswered) {
              colorClass = 'bg-emerald-500 text-white border-emerald-600';
            }

            const ringClass = isCurrent ? 'ring-2 ring-indigo-600 ring-offset-1' : '';

            return `
              <button
                type="button"
                onclick="app.jumpToQuestion(${idx})"
                class="h-9 rounded-xl border text-xs font-extrabold transition flex items-center justify-center ${colorClass} ${ringClass}"
              >
                ${idx + 1}
              </button>
            `;
          })
          .join('');
      }

      selectOption(optKey) {
        if (!this.activeExam) return;
        const q = this.activeExam.pkg.questions[this.activeExam.currentIndex];
        if (!q) return;
        this.activeExam.answers[q.id] = optKey;
        this.renderExamQuestion();
      }

      toggleDoubt() {
        if (!this.activeExam) return;
        const q = this.activeExam.pkg.questions[this.activeExam.currentIndex];
        if (!q) return;
        this.activeExam.doubts[q.id] = !this.activeExam.doubts[q.id];
        this.renderExamQuestion();
      }

      prevQuestion() {
        if (!this.activeExam) return;
        if (this.activeExam.currentIndex > 0) {
          this.activeExam.currentIndex -= 1;
          this.renderExamQuestion();
        }
      }

      nextQuestion() {
        if (!this.activeExam) return;
        const total = this.activeExam.pkg.questions.length;
        if (this.activeExam.currentIndex < total - 1) {
          this.activeExam.currentIndex += 1;
          this.renderExamQuestion();
        } else {
          this.confirmFinishExam();
        }
      }

      jumpToQuestion(index) {
        if (!this.activeExam) return;
        if (index >= 0 && index < this.activeExam.pkg.questions.length) {
          this.activeExam.currentIndex = index;
          this.renderExamQuestion();
        }
      }

      confirmFinishExam() {
        if (!this.activeExam) return;
        const questions = this.activeExam.pkg.questions || [];
        const answeredCount = questions.filter((q) => Boolean(this.activeExam.answers[q.id])).length;
        const unansweredCount = questions.length - answeredCount;

        this.openModal(`
          <div class="p-6 space-y-4">
            <h3 class="text-lg font-extrabold text-slate-900">Konfirmasi Pengumpulan Ujian</h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Anda telah menjawab <strong>${answeredCount}</strong> dari <strong>${questions.length}</strong> soal.
              ${
                unansweredCount > 0
                  ? `<span class="text-amber-700 font-semibold block mt-1">Masih ada ${unansweredCount} soal yang belum dijawab.</span>`
                  : `<span class="text-emerald-700 font-semibold block mt-1">Seluruh soal sudah terisi dengan lengkap.</span>`
              }
            </p>
            <div class="flex justify-end gap-2.5 pt-3 border-t border-slate-100">
              <button type="button" onclick="app.closeModal()" class="px-4 py-2.5 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-100">
                Periksa Kembali
              </button>
              <button type="button" onclick="app.closeModal(); app.finishExam(false);" class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-bold shadow-xs transition">
                Ya, Kumpulkan Sekarang
              </button>
            </div>
          </div>
        `);
      }

      finishExam(isForcedBan = false) {
        if (!this.activeExam) return;
        this.cleanupExamSecurity();
        if (this.activeExam.timerId) {
          clearInterval(this.activeExam.timerId);
        }

        const {
          pkg,
          studentName,
          studentClass,
          answers,
          totalSeconds,
          remainingSeconds,
          violationCount
        } = this.activeExam;

        const questions = pkg.questions || [];
        let correctCount = 0;
        let wrongCount = 0;
        let blankCount = 0;

        questions.forEach((q) => {
          const userAns = answers[q.id];
          if (!userAns) {
            blankCount += 1;
          } else if (userAns === q.correctAnswer) {
            correctCount += 1;
          } else {
            wrongCount += 1;
          }
        });

        const totalQuestions = questions.length;
        const score = totalQuestions > 0 ? Math.round((correctCount / totalQuestions) * 100) : 0;
        const durationUsedSeconds = Math.max(1, totalSeconds - remainingSeconds);
        const finishedAt = new Date().toISOString();

        const examStatus = isForcedBan
          ? `${violationCount} kali pelanggaran - BANNED (Ujian Dihentikan & Dikumpulkan Otomatis)`
          : `${violationCount} kali pelanggaran - Ujian Selesai Normal`;

        const resultRecord = {
          id: 'res-' + Date.now() + '-' + Math.random().toString(36).slice(2, 6),
          packageId: pkg.id,
          packageTitle: pkg.title,
          category: pkg.category,
          studentName,
          studentClass,
          finishedAt,
          durationUsedSeconds,
          correctCount,
          wrongCount,
          blankCount,
          totalQuestions,
          score,
          violationCount,
          isBanned: isForcedBan,
          examStatus
        };

        this.persistResult(resultRecord);
        this.lastResultData = {
          record: resultRecord,
          pkg,
          answers
        };
        this.activeExam = null;

        this.renderResultView();
        this.switchView('result');
      }

      renderResultView() {
        if (!this.lastResultData) return;
        const { record, pkg, answers } = this.lastResultData;

        document.getElementById('result-package-title').textContent = record.packageTitle;
        document.getElementById('result-student-name').textContent = record.studentName;
        document.getElementById('result-student-class').textContent = record.studentClass;
        document.getElementById('result-score').textContent = record.score;
        document.getElementById('result-correct').textContent = record.correctCount;
        document.getElementById('result-wrong').textContent = record.wrongCount;
        document.getElementById('result-blank').textContent = record.blankCount;
        document.getElementById('result-timestamp-info').textContent = `Selesai dikerjakan pada ${formatDateIndo(record.finishedAt)}`;

        // Predikat Nilai
        const predEl = document.getElementById('result-predicate');
        if (record.isBanned) {
          predEl.textContent = 'Diskualifikasi (Batas Pelanggaran)';
          predEl.className = 'inline-block mt-3 px-3 py-1 rounded-full text-xs font-bold bg-rose-100 text-rose-800';
        } else if (record.score >= 85) {
          predEl.textContent = 'Sangat Memuaskan';
          predEl.className = 'inline-block mt-3 px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800';
        } else if (record.score >= 70) {
          predEl.textContent = 'Baik / Lulus KKM';
          predEl.className = 'inline-block mt-3 px-3 py-1 rounded-full text-xs font-bold bg-indigo-100 text-indigo-800';
        } else {
          predEl.textContent = 'Perlu Pendalaman Materi';
          predEl.className = 'inline-block mt-3 px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800';
        }

        // Banner Status Pelanggaran Anti-Nyontek
        const vBanner = document.getElementById('result-violation-banner');
        const vIcon = document.getElementById('result-violation-icon');
        const vTitle = document.getElementById('result-violation-title');
        const vDesc = document.getElementById('result-violation-desc');

        if (record.isBanned) {
          vBanner.className = 'mb-6 rounded-2xl p-4 border flex items-start sm:items-center gap-3 text-xs sm:text-sm font-semibold bg-rose-50 border-rose-300 text-rose-900';
          vIcon.textContent = '⛔';
          vTitle.textContent = 'UJIAN DIBANNED & DIKUMPULKAN OTOMATIS';
          vDesc.textContent = `Siswa tercatat melakukan ${record.violationCount} kali pelanggaran keluar dari layar/tab ujian.`;
        } else if (record.violationCount > 0) {
          vBanner.className = 'mb-6 rounded-2xl p-4 border flex items-start sm:items-center gap-3 text-xs sm:text-sm font-semibold bg-amber-50 border-amber-300 text-amber-900';
          vIcon.textContent = '⚠️';
          vTitle.textContent = 'Catatan Pengawasan Ujian';
          vDesc.textContent = `${record.violationCount} kali pelanggaran terdeteksi — Ujian Selesai Normal.`;
        } else {
          vBanner.className = 'mb-6 rounded-2xl p-4 border flex items-start sm:items-center gap-3 text-xs sm:text-sm font-semibold bg-emerald-50 border-emerald-200 text-emerald-800';
          vIcon.textContent = '🛡️';
          vTitle.textContent = 'Status Pengawasan Ujian Bersih';
          vDesc.textContent = '0 kali pelanggaran — Ujian Selesai Normal tanpa berpindah tab/aplikasi.';
        }

        // Rincian Kunci & Pembahasan
        const reviewSection = document.getElementById('result-review-section');
        const reviewList = document.getElementById('result-review-list');
        if (!pkg.showExplanation) {
          reviewSection.classList.add('hidden');
          return;
        }

        reviewSection.classList.remove('hidden');
        reviewList.innerHTML = (pkg.questions || [])
          .map((q, idx) => {
            const userAns = answers[q.id] || null;
            const isCorrect = userAns === q.correctAnswer;
            const statusBadge = !userAns
              ? '<span class="px-2.5 py-1 rounded-lg text-xs font-bold bg-slate-100 text-slate-700">Tidak Dijawab</span>'
              : isCorrect
              ? '<span class="px-2.5 py-1 rounded-lg text-xs font-bold bg-emerald-100 text-emerald-800">✓ Benar</span>'
              : '<span class="px-2.5 py-1 rounded-lg text-xs font-bold bg-rose-100 text-rose-800">✕ Salah</span>';

            const optKeys = ['A', 'B', 'C', 'D', 'E'].filter((k) => k !== 'E' || stripHtmlToText(q.options && q.options.E));

            return `
              <div class="bg-white rounded-2xl border border-slate-200 p-5 sm:p-6 shadow-2xs space-y-4">
                <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-3">
                  <span class="font-extrabold text-sm text-indigo-700">Soal Nomor ${idx + 1}</span>
                  <div class="flex items-center gap-2 text-xs">
                    <span>Jawaban Anda: <strong>${userAns || '-'}</strong></span>
                    <span>•</span>
                    <span>Kunci: <strong class="text-emerald-700">${q.correctAnswer}</strong></span>
                    ${statusBadge}
                  </div>
                </div>

                ${
                  stripHtmlToText(q.passage)
                    ? `<div class="bg-slate-50 border border-slate-200 rounded-xl p-4 text-xs sm:text-sm font-serif text-slate-700 formatted-content max-h-48 overflow-y-auto custom-scroll">${sanitizeFormattedHtml(q.passage)}</div>`
                    : ''
                }

                <div class="formatted-content text-sm sm:text-base font-medium text-slate-900">
                  ${sanitizeFormattedHtml(q.question)}
                </div>

                <div class="space-y-1.5 text-xs sm:text-sm">
                  ${optKeys
                    .map((k) => {
                      const isKey = k === q.correctAnswer;
                      const isPickedWrong = k === userAns && !isKey;
                      let cls = 'bg-slate-50 border-slate-200 text-slate-700';
                      if (isKey) cls = 'bg-emerald-50 border-emerald-300 text-emerald-950 font-semibold';
                      else if (isPickedWrong) cls = 'bg-rose-50 border-rose-300 text-rose-950';
                      return `
                        <div class="p-2.5 rounded-xl border flex items-start gap-2.5 ${cls}">
                          <span class="font-extrabold shrink-0">${k}.</span>
                          <span class="formatted-content flex-1">${sanitizeFormattedHtml((q.options && q.options[k]) || '')}</span>
                        </div>
                      `;
                    })
                    .join('')}
                </div>

                ${
                  stripHtmlToText(q.explanation)
                    ? `
                      <div class="bg-indigo-50/70 border border-indigo-200 rounded-xl p-4 text-xs sm:text-sm text-indigo-950 space-y-1">
                        <span class="font-extrabold text-indigo-800 block uppercase tracking-wider text-[11px]">💡 Pembahasan:</span>
                        <div class="formatted-content leading-relaxed">${sanitizeFormattedHtml(q.explanation)}</div>
                      </div>
                    `
                    : ''
                }
              </div>
            `;
          })
          .join('');
      }

