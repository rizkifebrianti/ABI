      verifyAdminPassword(event) {
        event.preventDefault();
        const pwd = document.getElementById('admin-password-input').value;
        const errBox = document.getElementById('admin-login-error');

        if (pwd === 'UjianKikay21') {
          this.isAdminAuthenticated = true;
          this.closeModal();
          this.switchView('admin');
          this.setAdminTab('packages');
          this.showToast('Berhasil masuk ke Dashboard Admin.', 'success');
        } else {
          errBox.classList.remove('hidden');
        }
      }

      logoutAdmin() {
        this.isAdminAuthenticated = false;
        this.managingPackageId = null;
        this.showToast('Anda telah keluar dari sesi Admin.', 'info');
        this.navigateHome();
      }

      setAdminTab(tabName) {
        this.adminActiveTab = tabName;
        const tabs = ['packages', 'import', 'scores', 'cloud'];
        tabs.forEach((t) => {
          const btn = document.getElementById(`admin-tab-${t}`);
          const panel = document.getElementById(`admin-panel-${t}`);
          if (btn) {
            btn.className =
              t === tabName
                ? 'px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold bg-indigo-600 text-white shadow-2xs transition'
                : 'px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold bg-slate-100 text-slate-700 hover:bg-slate-200 transition';
          }
          if (panel) {
            if (t === tabName) panel.classList.remove('hidden');
            else panel.classList.add('hidden');
          }
        });

        if (tabName === 'packages') {
          this.closeQuestionManager();
          this.renderAdminPackages();
        } else if (tabName === 'import') {
          this.populateExistingPackageSelect();
        } else if (tabName === 'scores') {
          this.renderScoresAdminView();
          if (this.getActiveFirebaseUrl()) {
            this.fetchResultsFromCloud(false);
          }
        } else if (tabName === 'cloud') {
          this.renderCloudSettingsPanel();
        }
      }

      // ==================== 8. MANAJEMEN PAKET SOAL & EDITOR MANUAL ====================
      generateRandomToken() {
        const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
        let token = '';
        for (let i = 0; i < 6; i++) {
          token += chars.charAt(Math.floor(Math.random() * chars.length));
        }
        return token;
      }

      renderAdminPackages() {
        const countEl = document.getElementById('admin-pkg-count');
        if (countEl) countEl.textContent = this.packages.length;

        const grid = document.getElementById('admin-packages-grid');
