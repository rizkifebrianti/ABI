                  <div class="flex items-center justify-between gap-2 mb-2.5">
                    <span class="px-2.5 py-0.5 rounded-md text-[11px] font-extrabold bg-indigo-50 text-indigo-700 border border-indigo-200">
                      ${escapeHtmlText(pkg.category)}
                    </span>
                    <select
                      onchange="app.quickChangePackageStatus('${pkg.id}', this.value)"
