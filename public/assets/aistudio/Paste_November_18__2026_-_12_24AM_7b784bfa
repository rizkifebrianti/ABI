          tbody.innerHTML = `
            <tr>
              <td colspan="9" class="py-8 text-center text-xs sm:text-sm text-slate-500">
                Belum ada data pengerjaan siswa pada filter ini.
              </td>
            </tr>
          `;
          return;
        }

        tbody.innerHTML = filtered
          .map((r, idx) => {
            const vCount = Number(r.violationCount || 0);
            const isBanned = Boolean(r.isBanned) || vCount >= 3;
            const statusText =
              r.examStatus ||
              (isBanned
                ? `${vCount} kali pelanggaran - BANNED`
                : `${vCount} kali pelanggaran - Selesai Normal`);

            const violationBadge = isBanned
              ? `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-bold bg-rose-100 text-rose-800 border border-rose-200">⛔ ${escapeHtmlText(statusText)}</span>`
              : vCount > 0
              ? `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-bold bg-amber-100 text-amber-900 border border-amber-200">⚠️ ${escapeHtmlText(statusText)}</span>`
              : `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">🛡️ ${escapeHtmlText(statusText)}</span>`;

            return `
              <tr class="hover:bg-slate-50 transition">
                <td class="py-3 px-4 text-xs font-bold text-slate-500">${idx + 1}</td>
                <td class="py-3 px-4 font-bold text-slate-900">${escapeHtmlText(r.studentName)}</td>
                <td class="py-3 px-4 text-xs font-semibold text-slate-700">${escapeHtmlText(r.studentClass || '-')}</td>
                <td class="py-3 px-4 text-xs text-slate-700 max-w-xs truncate">${escapeHtmlText(r.packageTitle)}</td>
                <td class="py-3 px-4 text-xs text-slate-500 whitespace-nowrap">${formatDateIndo(r.finishedAt)}</td>
                <td class="py-3 px-4 text-xs">${violationBadge}</td>
                <td class="py-3 px-4 text-center text-xs font-semibold">
                  <span class="text-emerald-700">${r.correctCount}B</span> / <span class="text-rose-700">${r.wrongCount}S</span>
                </td>
                <td class="py-3 px-4 text-center">
                  <span class="px-2.5 py-1 rounded-lg font-extrabold text-xs bg-indigo-50 text-indigo-800 border border-indigo-200">${r.score}</span>
                </td>
                <td class="py-3 px-4 text-right">
                  <button
                    type="button"
                    onclick="app.removeResultFromDb('${r.id}'); app.renderScoresTable(); app.showToast('Data nilai dihapus.', 'info');"
                    class="px-2.5 py-1 rounded-lg text-xs font-bold text-rose-600 hover:bg-rose-50"
                  >
                    Hapus
                  </button>
                </td>
              </tr>
            `;
          })
          .join('');
      }

      exportScoresFile(format = 'xlsx') {
        if (!window.XLSX) {
          this.showToast('Library SheetJS belum siap.', 'error');
          return;
        }
        const filtered = this.getFilteredResults();
        if (filtered.length === 0) {
          this.showToast('Tidak ada data nilai untuk diekspor.', 'warning');
          return;
        }

        const rows = filtered.map((r, i) => {
          const vCount = Number(r.violationCount || 0);
          const isBanned = Boolean(r.isBanned) || vCount >= 3;
          return {
            No: i + 1,
            'Nama Lengkap Siswa': r.studentName,
            Kelas: r.studentClass || '-',
            'Paket Soal': r.packageTitle,
            Jenjang: r.category,
            'Waktu Selesai': formatDateIndo(r.finishedAt),
            'Jumlah Pelanggaran': vCount,
            'Keterangan Status Ujian': isBanned ? 'BANNED (3x Pelanggaran)' : 'Selesai Normal',
            'Jawaban Benar': r.correctCount,
            'Jawaban Salah': r.wrongCount,
            'Tidak Dijawab': r.blankCount,
            'Skor Akhir': r.score
          };
        });

        const ws = window.XLSX.utils.json_to_sheet(rows);
        const wb = window.XLSX.utils.book_new();
        window.XLSX.utils.book_append_sheet(wb, ws, 'Rekap_Nilai_CAT');

        if (format === 'csv') {
          window.XLSX.writeFile(wb, 'Rekap_Nilai_CAT_Bahasa_Indonesia.csv', { bookType: 'csv' });
        } else {
          window.XLSX.writeFile(wb, 'Rekap_Nilai_CAT_Bahasa_Indonesia.xlsx');
        }
        this.showToast(`Laporan berhasil diekspor ke format .${format}.`, 'success');
      }

      exportBankJson() {
        const payload = {
          exportedAt: new Date().toISOString(),
          app: 'CAT Bahasa Indonesia',
          packages: this.packages
        };
        const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `Backup_Bank_Soal_CAT_Bindo_${new Date().toISOString().slice(0, 10)}.json`;
        a.click();
        URL.revokeObjectURL(url);
        this.showToast('File backup Bank Soal (.json) berhasil diunduh.', 'success');
      }

      async importBankJson(event) {
        const file = event.target.files && event.target.files[0];
        if (!file) return;

        try {
          const text = await file.text();
          const parsed = JSON.parse(text);
          const incomingPackages = Array.isArray(parsed) ? parsed : parsed.packages;

          if (!Array.isArray(incomingPackages)) {
            throw new Error('Struktur file JSON tidak valid.');
          }

          this.packages = incomingPackages;
          this.saveToLocalStorage(STORAGE_KEYS.PACKAGES, this.packages);
          this.pushPackagesToCloud(false);
          this.renderAdminPackages();
          this.showToast(`Berhasil memulihkan ${incomingPackages.length} paket soal dari JSON.`, 'success');
        } catch (err) {
          this.showToast(err.message || 'Gagal mengimpor file JSON.', 'error');
        } finally {
          event.target.value = '';
        }
      }

      // ==================== 11. PENGATURAN FIREBASE CLOUD & EKSPOR HOSTING ====================
      renderCloudSettingsPanel() {
        const urlInput = document.getElementById('cloud-url-input');
        const pill = document.getElementById('cloud-panel-status-pill');
        const detailText = document.getElementById('cloud-connection-detail-text');
        const activeUrl = this.getActiveFirebaseUrl();

        if (urlInput) urlInput.value = activeUrl;

        if (activeUrl && this.isCloudConnected) {
          if (pill) {
            pill.className = 'inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 shrink-0';
            pill.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-500"></span> Cloud Terhubung';
          }
          if (detailText) {
            detailText.innerHTML = `Terhubung ke <code class="bg-white px-1.5 py-0.5 rounded border font-mono text-xs">${escapeHtmlText(activeUrl)}</code>. Paket soal dan nilai siswa otomatis tersinkronisasi antarperangkat.`;
          }
        } else if (activeUrl) {
          if (pill) {
            pill.className = 'inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-amber-50 text-amber-800 border border-amber-200 shrink-0';
            pill.innerHTML = '<span class="w-2 h-2 rounded-full bg-amber-500"></span> URL Tersimpan (Offline / Belum Sinkron)';
          }
          if (detailText) {
            detailText.textContent = 'URL database sudah tersimpan, tetapi belum berhasil terhubung. Periksa koneksi internet atau Rules Firebase (read/write: true).';
          }
        } else {
          if (pill) {
            pill.className = 'inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-slate-100 text-slate-700 border border-slate-200 shrink-0';
            pill.innerHTML = '<span class="w-2 h-2 rounded-full bg-slate-400"></span> Mode Lokal';
          }
          if (detailText) {
            detailText.textContent = 'Belum terhubung ke Firebase. Data soal dan nilai siswa saat ini hanya tersimpan di LocalStorage perangkat ini.';
          }
        }
      }

      async connectAndSyncFirebase() {
        const rawUrl = (document.getElementById('cloud-url-input')?.value || '').trim().replace(/\/+$/, '');
        if (!rawUrl || !rawUrl.startsWith('https://')) {
          this.showToast('Masukkan URL Firebase Realtime Database yang valid (diawali https://).', 'error');
          return;
        }

        localStorage.setItem(STORAGE_KEYS.FIREBASE_URL, rawUrl);
        this.updateCloudStatusBadge('syncing', 'Menghubungkan...');

        try {
          const checkRes = await fetch(`${rawUrl}/packages.json`, { cache: 'no-store' });
          if (!checkRes.ok) {
            throw new Error(`Server merespons HTTP ${checkRes.status}. Pastikan Rules Firebase diatur ke test mode.`);
          }
          const existingCloud = await checkRes.json();
          if (!existingCloud) {
            // Unggah paket awal dari perangkat admin ke Firebase jika cloud masih kosong
            await this.pushPackagesToCloud(false);
          } else {
            await this.syncFromCloud(false);
          }
          await this.fetchResultsFromCloud(false);
          this.updateCloudStatusBadge('connected', 'Cloud Terhubung');
          this.renderCloudSettingsPanel();
          this.showToast('Berhasil terhubung dan menyinkronkan data dengan Firebase Cloud!', 'success');
        } catch (err) {
          this.updateCloudStatusBadge('local', 'Mode Lokal');
          this.renderCloudSettingsPanel();
          this.showToast(err.message || 'Gagal terhubung ke Firebase Database.', 'error');
        }
      }

      disconnectFirebase() {
        localStorage.removeItem(STORAGE_KEYS.FIREBASE_URL);
        this.updateCloudStatusBadge('local', 'Mode Lokal');
        this.renderCloudSettingsPanel();
        this.showToast('Koneksi Firebase diputuskan. Aplikasi kembali ke Mode Lokal.', 'info');
      }

      downloadHostingReadyHtml() {
        const activeUrl = (document.getElementById('cloud-url-input')?.value || this.getActiveFirebaseUrl()).trim().replace(/\/+$/, '');
        let fullHtml = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;

        if (activeUrl) {
          fullHtml = fullHtml.replace(
            /const DEFAULT_FIREBASE_URL = ".*?";/,
            `const DEFAULT_FIREBASE_URL = "${activeUrl}";`
          );
        }

        const blob = new Blob([fullHtml], { type: 'text/html;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'index.html';
        a.click();
        URL.revokeObjectURL(url);

        this.showToast(
          activeUrl
            ? 'File index.html dengan koneksi Firebase tertanam berhasil diunduh!'
            : 'File index.html siap hosting berhasil diunduh!',
          'success'
        );
      }
    }

    // Inisialisasi instance aplikasi global
    window.app = new CATBahasaApp();
  </script>
