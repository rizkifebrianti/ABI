      savePackageForm(event, existingId) {
        event.preventDefault();
        const title = document.getElementById('pkg-form-title').value.trim();
        const category = document.getElementById('pkg-form-category').value;
        const duration = Math.max(1, parseInt(document.getElementById('pkg-form-duration').value, 10) || 30);
        const token = document.getElementById('pkg-form-token').value.trim().toUpperCase();
        const status = document.getElementById('pkg-form-status').value;
        const showExplanation = document.getElementById('pkg-form-explanation').checked;

        if (!title || !token) return;

        if (existingId) {
          const pkg = this.packages.find((p) => p.id === existingId);
          if (pkg) {
            pkg.title = title;
            pkg.category = category;
            pkg.duration = duration;
            pkg.token = token;
            pkg.status = status;
            pkg.showExplanation = showExplanation;
            this.persistPackage(pkg);
          }
          this.showToast('Pengaturan paket soal berhasil diperbarui.', 'success');
        } else {
          const newPkg = {
            id: 'pkg-' + Date.now(),
            title,
            category,
            duration,
            token,
            status,
            showExplanation,
            createdAt: new Date().toISOString(),
            questions: []
          };
          this.persistPackage(newPkg);
          this.showToast('Paket soal baru berhasil dibuat.', 'success');
        }

        this.closeModal();
        this.renderAdminPackages();
      }

      confirmDeletePackage(pkgId) {
        const pkg = this.packages.find((p) => p.id === pkgId);
        if (!pkg) return;

        this.openModal(`
          <div class="p-6 space-y-4">
            <h3 class="text-lg font-extrabold text-rose-700">Hapus Paket Soal?</h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Paket <strong>"${escapeHtmlText(pkg.title)}"</strong> beserta seluruh <strong>${(pkg.questions || []).length} butir soal</strong> di dalamnya akan dihapus permanen.
            </p>
            <div class="flex justify-end gap-2.5 pt-3 border-t border-slate-100">
              <button type="button" onclick="app.closeModal()" class="px-4 py-2.5 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-100">
                Batal
              </button>
              <button type="button" onclick="app.removePackageFromDb('${pkg.id}'); app.closeModal(); app.renderAdminPackages(); app.showToast('Paket soal dihapus.', 'info');" class="px-5 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-sm font-bold">
                Ya, Hapus Permanen
              </button>
            </div>
          </div>
        `);
      }

      openQuestionManager(pkgId) {
        const pkg = this.packages.find((p) => p.id === pkgId);
        if (!pkg) return;
        this.managingPackageId = pkgId;
        this.editingQuestionId = null;

        document.getElementById('admin-packages-list-view').classList.add('hidden');
        document.getElementById('admin-question-manager-view').classList.remove('hidden');

        document.getElementById('qm-package-title').textContent = pkg.title;
        document.getElementById('qm-package-meta').textContent = `${pkg.category} • ${pkg.duration} Menit • Token: ${pkg.token} • Status: ${pkg.status}`;

        this.resetQuestionForm();
        this.renderQuestionListInManager();
      }

      closeQuestionManager() {
        this.managingPackageId = null;
        this.editingQuestionId = null;
        const listView = document.getElementById('admin-packages-list-view');
        const qmView = document.getElementById('admin-question-manager-view');
        if (listView) listView.classList.remove('hidden');
        if (qmView) qmView.classList.add('hidden');
        this.renderAdminPackages();
      }

      initRichTextEditors() {
        const toolbars = document.querySelectorAll('[data-editor-toolbar]');
        toolbars.forEach((bar) => {
          const targetId = bar.getAttribute('data-editor-toolbar');
          bar.innerHTML = `
            <button type="button" onmousedown="event.preventDefault(); app.execEditorCmd('${targetId}', 'bold')" class="px-2 py-0.5 rounded bg-white hover:bg-indigo-50 border border-slate-200 text-xs font-extrabold text-slate-800" title="Tebal (Bold)">B</button>
            <button type="button" onmousedown="event.preventDefault(); app.execEditorCmd('${targetId}', 'italic')" class="px-2 py-0.5 rounded bg-white hover:bg-indigo-50 border border-slate-200 text-xs italic font-serif font-bold text-slate-800" title="Miring (Italic)">I</button>
            <button type="button" onmousedown="event.preventDefault(); app.execEditorCmd('${targetId}', 'underline')" class="px-2 py-0.5 rounded bg-white hover:bg-indigo-50 border border-slate-200 text-xs underline font-bold text-slate-800" title="Garis Bawah (Underline)">U</button>
            <button type="button" onmousedown="event.preventDefault(); app.transformEditorSelectionUppercase('${targetId}')" class="px-2 py-0.5 rounded bg-white hover:bg-indigo-50 border border-slate-200 text-[11px] font-bold text-slate-800" title="Ubah Teks Terpilih ke Huruf KAPITAL">KAPITAL</button>
          `;
        });
      }

      execEditorCmd(editorId, command) {
        const el = document.getElementById(editorId);
        if (!el) return;
        el.focus();
        document.execCommand(command, false, null);
      }

      transformEditorSelectionUppercase(editorId) {
        const el = document.getElementById(editorId);
        if (!el) return;
        el.focus();
        const sel = window.getSelection();
        if (!sel || sel.rangeCount === 0) return;
        const selectedText = sel.toString();
        if (!selectedText) {
          this.showToast('Sorot/blok terlebih dahulu kata yang ingin diubah ke huruf KAPITAL.', 'info');
          return;
        }
        document.execCommand('insertText', false, selectedText.toUpperCase());
      }

      copyPreviousPassage() {
        const pkg = this.packages.find((p) => p.id === this.managingPackageId);
        if (!pkg || !pkg.questions || pkg.questions.length === 0) {
          this.showToast('Belum ada soal sebelumnya pada paket ini.', 'warning');
          return;
        }

        let targetIdx = pkg.questions.length - 1;
        if (this.editingQuestionId) {
          const curIdx = pkg.questions.findIndex((q) => q.id === this.editingQuestionId);
          if (curIdx > 0) targetIdx = curIdx - 1;
        }

        const prevQ = pkg.questions[targetIdx];
        if (!prevQ || !stripHtmlToText(prevQ.passage)) {
          this.showToast('Nomor soal sebelumnya tidak memiliki teks bacaan.', 'warning');
          return;
        }

        document.getElementById('editor-passage').innerHTML = sanitizeFormattedHtml(prevQ.passage);
        this.showToast(`Teks bacaan dari Soal No. ${targetIdx + 1} berhasil disalin.`, 'success');
      }

      resetQuestionForm() {
        this.editingQuestionId = null;
        document.getElementById('qform-heading').textContent = 'Tambah Butir Soal Manual';
        document.getElementById('qform-edit-badge').classList.add('hidden');
        document.getElementById('editor-passage').innerHTML = '';
        document.getElementById('editor-question').innerHTML = '';
        ['A', 'B', 'C', 'D', 'E'].forEach((k) => {
          document.getElementById(`editor-opt-${k}`).innerHTML = '';
        });
        document.getElementById('qform-correct').value = 'A';
        document.getElementById('editor-explanation').innerHTML = '';
      }

      editQuestionInForm(qId) {
        const pkg = this.packages.find((p) => p.id === this.managingPackageId);
        if (!pkg) return;
        const q = (pkg.questions || []).find((item) => item.id === qId);
        if (!q) return;

        this.editingQuestionId = q.id;
        document.getElementById('qform-heading').textContent = 'Edit Butir Soal';
        document.getElementById('qform-edit-badge').classList.remove('hidden');

        document.getElementById('editor-passage').innerHTML = sanitizeFormattedHtml(q.passage || '');
        document.getElementById('editor-question').innerHTML = sanitizeFormattedHtml(q.question || '');
        ['A', 'B', 'C', 'D', 'E'].forEach((k) => {
          document.getElementById(`editor-opt-${k}`).innerHTML = sanitizeFormattedHtml((q.options && q.options[k]) || '');
        });
        document.getElementById('qform-correct').value = q.correctAnswer || 'A';
        document.getElementById('editor-explanation').innerHTML = sanitizeFormattedHtml(q.explanation || '');

        document.getElementById('qform-heading').scrollIntoView({ behavior: 'smooth', block: 'center' });
      }

      saveManualQuestion() {
        const pkg = this.packages.find((p) => p.id === this.managingPackageId);
        if (!pkg) return;

        const passage = sanitizeFormattedHtml(document.getElementById('editor-passage').innerHTML);
        const question = sanitizeFormattedHtml(document.getElementById('editor-question').innerHTML);
        const options = {
          A: sanitizeFormattedHtml(document.getElementById('editor-opt-A').innerHTML),
          B: sanitizeFormattedHtml(document.getElementById('editor-opt-B').innerHTML),
          C: sanitizeFormattedHtml(document.getElementById('editor-opt-C').innerHTML),
          D: sanitizeFormattedHtml(document.getElementById('editor-opt-D').innerHTML),
          E: sanitizeFormattedHtml(document.getElementById('editor-opt-E').innerHTML)
        };
        const correctAnswer = document.getElementById('qform-correct').value;
        const explanation = sanitizeFormattedHtml(document.getElementById('editor-explanation').innerHTML);

        if (!stripHtmlToText(question)) {
          this.showToast('Kolom Pertanyaan wajib diisi!', 'error');
          return;
        }
        if (!stripHtmlToText(options.A) || !stripHtmlToText(options.B) || !stripHtmlToText(options.C) || !stripHtmlToText(options.D)) {
          this.showToast('Minimal Opsi A, B, C, dan D wajib diisi!', 'error');
          return;
        }
        if (correctAnswer === 'E' && !stripHtmlToText(options.E)) {
          this.showToast('Kunci jawaban E dipilih, tetapi Opsi E masih kosong!', 'error');
          return;
        }

        if (!Array.isArray(pkg.questions)) pkg.questions = [];

        if (this.editingQuestionId) {
          const idx = pkg.questions.findIndex((item) => item.id === this.editingQuestionId);
          if (idx >= 0) {
            pkg.questions[idx] = {
              ...pkg.questions[idx],
              passage,
              question,
              options,
              correctAnswer,
              explanation
            };
          }
          this.showToast('Perubahan butir soal berhasil disimpan.', 'success');
        } else {
          pkg.questions.push({
            id: 'q-' + Date.now() + '-' + Math.random().toString(36).slice(2, 5),
            passage,
            question,
            options,
            correctAnswer,
            explanation
          });
          this.showToast('Butir soal baru berhasil ditambahkan ke paket.', 'success');
        }

        this.persistPackage(pkg);
        this.resetQuestionForm();
        this.renderQuestionListInManager();
      }

