      async handleFileUpload(event) {
        const file = event.target.files && event.target.files[0];
        if (!file) return;

        const loader = document.getElementById('import-loading-indicator');
        if (loader) loader.classList.remove('hidden');

        try {
          const ext = file.name.split('.').pop().toLowerCase();
          let extracted = [];

          if (ext === 'xlsx' || ext === 'xls' || ext === 'csv') {
            extracted = await this.parseExcelFile(file);
          } else if (ext === 'docx') {
            extracted = await this.parseDocxFile(file);
          } else if (ext === 'pdf') {
            extracted = await this.parsePdfFile(file);
          } else {
            throw new Error('Format file tidak didukung. Gunakan .xlsx, .xls, .csv, .docx, atau .pdf.');
          }

          if (!extracted || extracted.length === 0) {
            throw new Error('Tidak ditemukan butir soal yang valid di dalam dokumen tersebut.');
          }

          this.importedPreviewQuestions = extracted;
          const baseName = file.name.replace(/\.[^/.]+$/, '').replace(/[_-]+/g, ' ');
          document.getElementById('imp-pkg-title').value = baseName;
          document.getElementById('imp-pkg-token').value = this.generateRandomToken();

          this.renderImportPreview();
          this.showToast(`Berhasil mengekstrak ${extracted.length} soal dari dokumen!`, 'success');
        } catch (err) {
          console.error(err);
          this.showToast(err.message || 'Gagal membaca file dokumen.', 'error');
        } finally {
          if (loader) loader.classList.add('hidden');
          event.target.value = '';
        }
      }

      async parseExcelFile(file) {
        const buffer = await file.arrayBuffer();
        const wb = window.XLSX.read(buffer, { type: 'array' });
        const firstSheet = wb.Sheets[wb.SheetNames[0]];
        const rows = window.XLSX.utils.sheet_to_json(firstSheet, { defval: '' });

        return rows
          .map((row) => {
            const getCol = (keys) => {
              for (const k of Object.keys(row)) {
                const norm = k.trim().toLowerCase();
                if (keys.includes(norm)) return String(row[k] || '').trim();
              }
              return '';
            };

            const passage = sanitizeFormattedHtml(getCol(['teks bacaan', 'wacana', 'bacaan', 'passage']));
            const question = sanitizeFormattedHtml(getCol(['pertanyaan', 'soal', 'question']));
            const optA = sanitizeFormattedHtml(getCol(['opsi a', 'pilihan a', 'a']));
            const optB = sanitizeFormattedHtml(getCol(['opsi b', 'pilihan b', 'b']));
            const optC = sanitizeFormattedHtml(getCol(['opsi c', 'pilihan c', 'c']));
            const optD = sanitizeFormattedHtml(getCol(['opsi d', 'pilihan d', 'd']));
            const optE = sanitizeFormattedHtml(getCol(['opsi e', 'pilihan e', 'e']));
            let key = getCol(['kunci jawaban', 'kunci', 'jawaban', 'answer']).toUpperCase().replace(/[^A-E]/g, '');
            if (!key) key = 'A';
            const explanation = sanitizeFormattedHtml(getCol(['pembahasan', 'penjelasan', 'explanation']));

            if (!stripHtmlToText(question) || !stripHtmlToText(optA)) return null;

            return {
              id: 'q-imp-' + Date.now() + '-' + Math.random().toString(36).slice(2, 6),
              passage,
              question,
              options: { A: optA, B: optB, C: optC, D: optD, E: optE },
              correctAnswer: key.charAt(0),
              explanation
            };
          })
          .filter(Boolean);
      }

      async parseDocxFile(file) {
        if (!window.mammoth) throw new Error('Library Mammoth.js tidak tersedia.');
        const arrayBuffer = await file.arrayBuffer();
        const result = await window.mammoth.convertToHtml({ arrayBuffer });
        const html = result.value || '';

        const tempDiv = document.createElement('div');
        tempDiv.innerHTML = html;
        const blocks = Array.from(tempDiv.querySelectorAll('p, li'))
          .map((el) => sanitizeFormattedHtml(el.innerHTML))
          .filter((line) => stripHtmlToText(line).length > 0);

        return this.parseStructuredBlocksToQuestions(blocks);
      }

      async parsePdfFile(file) {
        if (!window.pdfjsLib) throw new Error('Library PDF.js tidak tersedia.');
        const arrayBuffer = await file.arrayBuffer();
        const pdf = await window.pdfjsLib.getDocument({ data: arrayBuffer }).promise;
        const lines = [];

        for (let pageNum = 1; pageNum <= pdf.numPages; pageNum++) {
          const page = await pdf.getPage(pageNum);
          const content = await page.getTextContent();
          let currentLine = '';
          let lastY = null;

          for (const item of content.items) {
            const y = item.transform ? Math.round(item.transform[5]) : null;
            if (lastY !== null && y !== null && Math.abs(y - lastY) > 6) {
              if (stripHtmlToText(currentLine)) lines.push(sanitizeFormattedHtml(currentLine));
              currentLine = '';
            }
            lastY = y;

            let str = escapeHtmlText(item.str || '');
            const fontName = (item.fontName || '').toLowerCase();
            if (fontName.includes('bold') && fontName.includes('italic')) {
              str = `<b><i>${str}</i></b>`;
            } else if (fontName.includes('bold')) {
              str = `<b>${str}</b>`;
            } else if (fontName.includes('italic') || fontName.includes('oblique')) {
              str = `<i>${str}</i>`;
            }
            currentLine += str + ' ';
          }
          if (stripHtmlToText(currentLine)) {
            lines.push(sanitizeFormattedHtml(currentLine));
          }
        }

        return this.parseStructuredBlocksToQuestions(lines);
      }

      parseStructuredBlocksToQuestions(blocks) {
        const questions = [];
        let sharedPassage = '';
        let current = null;

        const pushCurrent = () => {
          if (current && stripHtmlToText(current.question) && stripHtmlToText(current.options.A)) {
            questions.push({
              id: 'q-doc-' + Date.now() + '-' + Math.random().toString(36).slice(2, 6),
              passage: current.passage || sharedPassage,
              question: current.question,
              options: current.options,
              correctAnswer: current.correctAnswer || 'A',
              explanation: current.explanation || ''
            });
          }
          current = null;
        };

        for (const htmlLine of blocks) {
          const plain = stripHtmlToText(htmlLine);

          if (/^(wacana|teks\s*bacaan|bacaan)\s*[:.-]/i.test(plain)) {
            pushCurrent();
            sharedPassage = htmlLine.replace(/^(<[^>]+>)*\s*(wacana|teks\s*bacaan|bacaan)\s*[:.-]\s*/i, '');
            continue;
          }

          if (/^\d+[\.\)]\s+/.test(plain)) {
            pushCurrent();
            const qClean = htmlLine.replace(/^(<[^>]+>)*\s*\d+[\.\)]\s*/, '');
            current = {
              passage: sharedPassage,
              question: qClean,
              options: { A: '', B: '', C: '', D: '', E: '' },
              correctAnswer: 'A',
              explanation: ''
            };
            continue;
          }

          if (!current) {
            sharedPassage = sharedPassage ? `${sharedPassage}<p>${htmlLine}</p>` : `<p>${htmlLine}</p>`;
            continue;
          }

          const optMatch = plain.match(/^([A-E])[\.\)]\s+/i);
          if (optMatch) {
            const letter = optMatch[1].toUpperCase();
            current.options[letter] = htmlLine.replace(/^(<[^>]+>)*\s*[A-E][\.\)]\s*/i, '');
            continue;
          }

          const keyMatch = plain.match(/^(kunci(\s*jawaban)?|jawaban)\s*[:.-]\s*([A-E])/i);
          if (keyMatch) {
            current.correctAnswer = keyMatch[3].toUpperCase();
            continue;
          }

          if (/^(pembahasan|penjelasan)\s*[:.-]/i.test(plain)) {
            current.explanation = htmlLine.replace(/^(<[^>]+>)*\s*(pembahasan|penjelasan)\s*[:.-]\s*/i, '');
            continue;
          }

          if (current.explanation) {
            current.explanation += `<br/>${htmlLine}`;
          } else if (!stripHtmlToText(current.options.A)) {
            current.question += `<br/>${htmlLine}`;
          }
        }

        pushCurrent();
        return questions;
      }

