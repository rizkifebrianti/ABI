<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CAT Bahasa Indonesia — Portal Ujian &amp; Administrasi Bimbel</title>

  <!-- Google Fonts: Inter & Merriweather -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Merriweather:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet" />

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Client-Side Document Libraries: Mammoth.js (DOCX), SheetJS (XLSX/CSV), PDF.js (PDF) -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.6.0/mammoth.browser.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
            serif: ['Merriweather', 'Georgia', 'serif']
          }
        }
      }
    };
    if (window.pdfjsLib) {
      window.pdfjsLib.GlobalWorkerOptions.workerSrc =
        'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
    }
  </script>

  <style>
    /* Pelestarian Format Ejaan Bahasa Indonesia secara eksplisit */
    .formatted-content b,
    .formatted-content strong {
      font-weight: 700;
    }
    .formatted-content i,
    .formatted-content em {
      font-style: italic;
    }
    .formatted-content u {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .formatted-content p {
      margin-bottom: 0.75rem;
    }
    .formatted-content p:last-child {
      margin-bottom: 0;
    }

    /* Rich Text Editor styling */
    .rich-editor {
      min-height: 92px;
      outline: none;
      line-height: 1.65;
    }
    .rich-editor:empty:before {
      content: attr(data-placeholder);
      color: #94a3b8;
      pointer-events: none;
      display: block;
    }
    .rich-editor b,
    .rich-editor strong {
      font-weight: 700;
    }
    .rich-editor i,
    .rich-editor em {
      font-style: italic;
    }
    .rich-editor u {
      text-decoration: underline;
    }

    /* Scrollbar halus untuk panel wacana dan soal */
    .custom-scroll::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    .custom-scroll::-webkit-scrollbar-track {
      background: #f1f5f9;
      border-radius: 9999px;
    }
    .custom-scroll::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 9999px;
    }
    .custom-scroll::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in {
      animation: fadeIn 0.2s ease-out forwards;
    }
  </style>
</head>

<body class="bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col">

  <!-- ==================== GLOBAL TOAST NOTIFICATION ==================== -->
  <div id="toast-container" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none px-4 sm:px-0"></div>

  <!-- ==================== GLOBAL CUSTOM MODAL CONTAINER ==================== -->
  <div id="modal-backdrop" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-40 items-center justify-center p-4 overflow-y-auto hidden">
    <div id="modal-box" class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-lg overflow-hidden animate-fade-in my-auto"></div>
  </div>

  <!-- ==================== TOP NAVBAR (PORTAL & ADMIN) ==================== -->
  <header id="main-navbar" class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-2xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
      <!-- Brand / Logo Kiri -->
      <button onclick="app.navigateHome()" class="flex items-center gap-3 text-left group focus:outline-none">
        <div class="w-10 h-10 rounded-xl bg-indigo-600 text-white flex items-center justify-center shadow-sm group-hover:bg-indigo-700 transition shrink-0">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
          </svg>
        </div>
        <div>
          <span class="font-extrabold text-lg sm:text-xl tracking-tight text-slate-900 block leading-tight">CAT Bahasa Indonesia</span>
          <span class="text-xs text-slate-500 hidden sm:block">Sistem Evaluasi &amp; Tryout Bimbingan Belajar Privat</span>
        </div>
      </button>

      <!-- Tombol Kanan Atas -->
      <div class="flex items-center gap-2 sm:gap-3">
        <span id="db-status-badge" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] sm:text-xs font-semibold bg-slate-100 text-slate-700 border border-slate-200" title="Status Koneksi Database">
          <span id="db-status-dot" class="w-2 h-2 rounded-full bg-slate-400"></span>
          <span id="db-status-text">Mode Lokal</span>
        </span>
        <button id="btn-refresh-portal" onclick="app.syncFromCloud(true)" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-indigo-50 text-indigo-700 hover:bg-indigo-100 border border-indigo-200 active:scale-[0.99] transition" title="Muat Ulang Paket Soal Terbaru">
          <svg id="icon-refresh-portal" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
          </svg>
          <span class="hidden sm:inline">Refresh Soal</span>
        </button>
        <button id="btn-admin-nav" onclick="app.handleAdminNavClick()" class="inline-flex items-center gap-2 px-3.5 sm:px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-slate-900 text-white hover:bg-slate-800 active:scale-[0.99] transition shadow-xs">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
          </svg>
          <span id="btn-admin-nav-text">Login Admin</span>
        </button>
      </div>
    </div>
  </header>

  <!-- ==================== VIEW 1: PORTAL SISWA (HALAMAN AWAL) ==================== -->
  <main id="view-portal" class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10">
    <!-- Hero Banner -->
    <div class="bg-gradient-to-br from-indigo-900 via-indigo-800 to-slate-900 rounded-3xl p-6 sm:p-10 text-white shadow-lg mb-8 relative overflow-hidden">
      <div class="relative z-10 max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 border border-white/15 text-indigo-100 text-xs font-semibold mb-4">
          <span>📚</span> Portal Ujian Berbasis Komputer (CAT)
        </div>
        <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight mb-3 leading-tight">
          Uji Pemahaman Literasi, Ejaan (EYD V), &amp; Tata Bahasa Indonesia
        </h1>
        <p class="text-indigo-100/90 text-sm sm:text-base leading-relaxed mb-5">
          Pilih paket soal sesuai jenjang belajarmu, masukkan nama lengkap, kelas, beserta <strong>Token Kuis</strong> dari tutor, dan kerjakan simulasi ujian dengan tampilan wacana berdampingan.
        </p>
        <div class="flex flex-wrap items-center gap-2 text-xs text-indigo-200 bg-white/10 border border-white/15 rounded-xl px-3.5 py-2.5 w-fit">
          <span class="font-semibold text-amber-300">💡 Info Simulasi:</span>
          <span>Token paket aktif tersedia: <code class="bg-slate-900/60 px-1.5 py-0.5 rounded text-white font-mono">SNBT2026</code>, <code class="bg-slate-900/60 px-1.5 py-0.5 rounded text-white font-mono">SMA2026</code>, <code class="bg-slate-900/60 px-1.5 py-0.5 rounded text-white font-mono">CPNS2026</code></span>
        </div>
      </div>
      <div class="hidden lg:block absolute -right-10 -bottom-12 w-72 h-72 rounded-full bg-indigo-500/20 blur-2xl pointer-events-none"></div>
    </div>

    <!-- Bar Pencarian & Filter Jenjang -->
    <div class="bg-white rounded-2xl p-4 sm:p-5 border border-slate-200 shadow-2xs mb-6 space-y-4">
      <div class="flex flex-col md:flex-row gap-3 items-stretch md:items-center justify-between">
        <!-- Input Pencarian -->
        <div class="relative flex-1">
          <svg class="w-5 h-5 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 115 11a6 6 0 0112 0z"></path>
          </svg>
          <input
            id="portal-search-input"
            type="text"
            oninput="app.setPortalSearch(this.value)"
            placeholder="Cari judul paket soal (contoh: Literasi SNBT, EYD V, TWK CPNS)..."
            class="w-full pl-11 pr-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition"
          />
        </div>

        <div class="text-xs font-medium text-slate-500 shrink-0 text-right">
          Menampilkan <span id="portal-count-label" class="font-bold text-slate-800">0</span> paket aktif
        </div>
      </div>

      <!-- Tombol Filter Kategori Jenjang -->
      <div id="portal-category-filters" class="flex flex-wrap gap-2"></div>
    </div>

    <!-- Katalog Kartu Paket Soal (Hanya Status Published) -->
    <div id="portal-packages-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5"></div>
  </main>

  <!-- ==================== VIEW 2: RUANG UJIAN CAT ==================== -->
  <section id="view-exam" class="hidden flex-1 flex-col bg-slate-100 min-h-screen select-none">
    <!-- Top Exam Header -->
    <div class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-xs">
      <div class="max-w-7xl mx-auto px-3 sm:px-6 py-2.5 sm:py-3 flex flex-wrap items-center justify-between gap-2 sm:gap-4">
        <!-- Info Paket & Peserta -->
        <div class="min-w-0 flex-1">
          <div class="flex items-center gap-2">
            <span id="exam-category-badge" class="px-2 py-0.5 rounded-md text-[11px] font-bold bg-indigo-50 text-indigo-700 border border-indigo-200 shrink-0">UTBK / SNBT</span>
            <h1 id="exam-package-title" class="font-bold text-sm sm:text-base text-slate-900 truncate">Judul Paket Soal</h1>
          </div>
          <p class="text-xs text-slate-500 truncate mt-0.5">
            Peserta: <strong id="exam-student-name" class="text-slate-700">Nama Siswa</strong>
            <span class="mx-1.5 text-slate-300">•</span>
            Kelas: <strong id="exam-student-class" class="text-slate-700">-</strong>
          </p>
        </div>

        <!-- Kontrol Pelanggaran Anti-Nyontek, Ukuran Huruf, Timer & Tombol Selesai -->
        <div class="flex flex-wrap items-center gap-2 sm:gap-3 shrink-0">
          <!-- Indikator Pelanggaran Anti-Nyontek Real-Time -->
          <div id="exam-violation-badge" class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs font-bold" title="Batas maksimal pindah tab/aplikasi adalah 3 kali">
            <span>🛡️</span>
            <span class="hidden sm:inline">Pelanggaran:</span>
            <span id="exam-violation-count">0/3</span>
          </div>

          <!-- Pengatur Ukuran Huruf (A- / A+) -->
          <div class="inline-flex items-center bg-slate-100 rounded-xl p-1 border border-slate-200" title="Atur Ukuran Huruf Bacaan &amp; Soal">
            <button onclick="app.adjustFontSize(-1)" class="px-2.5 py-1 rounded-lg text-xs font-bold text-slate-700 hover:bg-white hover:shadow-2xs transition" aria-label="Perkecil huruf">A-</button>
            <span id="exam-font-label" class="px-1.5 text-[11px] font-semibold text-slate-500 hidden sm:inline">100%</span>
            <button onclick="app.adjustFontSize(1)" class="px-2.5 py-1 rounded-lg text-xs font-bold text-slate-700 hover:bg-white hover:shadow-2xs transition" aria-label="Perbesar huruf">A+</button>
          </div>

          <!-- Timer Hitung Mundur -->
          <div id="exam-timer-box" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-900 text-white font-mono text-sm font-bold shadow-2xs">
            <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span id="exam-timer-text">30:00</span>
          </div>

          <!-- Tombol Selesai Ujian -->
          <button onclick="app.confirmFinishExam()" class="px-3.5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs sm:text-sm font-bold shadow-xs transition">
            Selesai
          </button>
        </div>
      </div>

      <!-- Tab Navigasi Mobile (Hanya muncul pada layar HP jika soal memiliki teks bacaan) -->
      <div id="exam-mobile-tabs" class="lg:hidden border-t border-slate-200 bg-slate-50 px-3 py-2 grid grid-cols-2 gap-2">
        <button id="tab-mobile-passage" onclick="app.setMobileExamTab('passage')" class="py-2 px-3 rounded-xl text-xs font-bold bg-indigo-600 text-white shadow-2xs transition">
          📖 Teks Bacaan
        </button>
        <button id="tab-mobile-question" onclick="app.setMobileExamTab('question')" class="py-2 px-3 rounded-xl text-xs font-bold bg-white text-slate-700 border border-slate-300 transition">
          ✍️ Pertanyaan &amp; Opsi
        </button>
      </div>
    </div>

    <!-- Main Split-Screen Container -->
    <div class="flex-1 max-w-7xl w-full mx-auto px-3 sm:px-6 py-4 flex flex-col lg:flex-row gap-4">
      <!-- Area Kerja Utama (Split Screen: Panel Kiri Bacaan & Panel Kanan Pertanyaan) -->
      <div id="exam-workspace" class="flex-1 grid grid-cols-1 lg:grid-cols-12 gap-4 min-h-[65vh]">
        <!-- PANEL KIRI: TEKS BACAAN / WACANA -->
        <div id="exam-passage-panel" class="lg:col-span-6 bg-white rounded-2xl border border-slate-200 shadow-2xs flex flex-col overflow-hidden lg:max-h-[calc(100vh-145px)]">
          <div class="px-4 py-3 bg-indigo-50/70 border-b border-indigo-100 flex items-center justify-between">
            <span class="text-xs font-extrabold uppercase tracking-wider text-indigo-800 flex items-center gap-1.5">
              <span>📖</span> Wacana / Teks Bacaan
            </span>
            <span class="text-[11px] text-indigo-600 font-medium">Gulir mandiri</span>
          </div>
          <div id="exam-passage-content" class="p-5 sm:p-6 overflow-y-auto custom-scroll formatted-content font-serif text-slate-800 leading-relaxed flex-1"></div>
        </div>

        <!-- PANEL KANAN: PERTANYAAN & PILIHAN GANDA -->
        <div id="exam-question-panel" class="lg:col-span-6 bg-white rounded-2xl border border-slate-200 shadow-2xs flex flex-col overflow-hidden lg:max-h-[calc(100vh-145px)]">
          <!-- Header Nomor Soal -->
          <div class="px-4 sm:px-6 py-3 bg-slate-50 border-b border-slate-200 flex items-center justify-between gap-2">
            <div class="flex items-center gap-2">
              <span class="px-3 py-1 rounded-lg bg-indigo-600 text-white font-bold text-xs sm:text-sm">
                Soal No. <span id="exam-q-number">1</span>
              </span>
              <span class="text-xs text-slate-500">dari <span id="exam-q-total">10</span> soal</span>
            </div>

            <!-- Tombol Ragu-ragu -->
            <button id="btn-toggle-doubt" onclick="app.toggleDoubt()" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold border border-amber-300 bg-amber-50 text-amber-800 hover:bg-amber-100 transition">
              <span id="doubt-checkbox-icon">☐</span> Ragu-ragu
            </button>
          </div>

          <!-- Isi Pertanyaan & Opsi Jawaban (Scrollable) -->
          <div class="p-5 sm:p-6 overflow-y-auto custom-scroll flex-1 space-y-5">
            <div id="exam-question-text" class="formatted-content text-slate-900 font-medium leading-relaxed"></div>
            <div id="exam-options-list" class="space-y-2.5"></div>
          </div>

          <!-- Footer Navigasi Sebelumnya / Selanjutnya -->
          <div class="px-4 sm:px-6 py-3.5 bg-slate-50 border-t border-slate-200 flex items-center justify-between gap-3">
            <button id="btn-exam-prev" onclick="app.prevQuestion()" class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-white border border-slate-300 text-slate-700 hover:bg-slate-100 disabled:opacity-40 disabled:pointer-events-none transition">
              ← Sebelumnya
            </button>

            <button id="btn-exam-next" onclick="app.nextQuestion()" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold bg-indigo-600 hover:bg-indigo-700 text-white shadow-2xs transition">
              Selanjutnya →
            </button>
          </div>
        </div>
      </div>

      <!-- SIDEBAR PETA NAVIGASI NOMOR SOAL -->
      <aside class="w-full lg:w-64 shrink-0 bg-white rounded-2xl border border-slate-200 shadow-2xs p-4 flex flex-col justify-between lg:max-h-[calc(100vh-145px)]">
        <div>
          <h2 class="text-xs font-extrabold uppercase tracking-wider text-slate-700 mb-3 flex items-center justify-between">
            <span>Navigasi Nomor Soal</span>
            <span id="exam-answered-summary" class="text-indigo-600 font-bold">0/0</span>
          </h2>

          <!-- Grid Nomor Soal -->
          <div id="exam-nav-grid" class="grid grid-cols-5 sm:grid-cols-8 lg:grid-cols-5 gap-2 max-h-60 lg:max-h-[42vh] overflow-y-auto custom-scroll pr-1"></div>
        </div>

        <!-- Legenda Indikator Warna -->
        <div class="mt-4 pt-3 border-t border-slate-200 space-y-2 text-xs text-slate-600">
          <div class="flex items-center gap-2">
            <span class="w-4 h-4 rounded-md bg-emerald-500 inline-block shrink-0"></span>
            <span>Sudah dijawab</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-4 h-4 rounded-md bg-amber-400 inline-block shrink-0"></span>
            <span>Ragu-ragu</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-4 h-4 rounded-md bg-white border border-slate-300 inline-block shrink-0"></span>
            <span>Belum dijawab</span>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- ==================== VIEW 3: HALAMAN HASIL UJIAN ==================== -->
  <section id="view-result" class="hidden flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Kartu Skor Utama -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden mb-8">
      <div class="bg-gradient-to-r from-indigo-600 to-slate-900 p-6 sm:p-8 text-white text-center">
        <span class="inline-block px-3 py-1 rounded-full bg-white/15 text-xs font-semibold uppercase tracking-wider mb-2">
          Hasil Evaluasi Ujian CAT
        </span>
        <h1 id="result-package-title" class="text-xl sm:text-2xl font-extrabold mb-1">Nama Paket Soal</h1>
        <p class="text-indigo-200 text-sm">
          Peserta: <strong id="result-student-name" class="text-white">Nama Siswa</strong>
          <span class="mx-2 text-indigo-300/60">|</span>
          Kelas: <strong id="result-student-class" class="text-white">-</strong>
        </p>
      </div>

      <div class="p-6 sm:p-8">
        <!-- Banner Status Pengerjaan & Keterangan Pelanggaran Anti-Nyontek -->
        <div id="result-violation-banner" class="mb-6 rounded-2xl p-4 border flex items-start sm:items-center gap-3 text-xs sm:text-sm font-semibold bg-emerald-50 border-emerald-200 text-emerald-800">
          <span id="result-violation-icon" class="text-lg leading-none shrink-0">🛡️</span>
          <div class="flex-1">
            <span id="result-violation-title" class="font-extrabold block">Status Pengawasan Ujian</span>
            <span id="result-violation-desc" class="font-medium">0 kali pelanggaran - Ujian Selesai Normal</span>
          </div>
        </div>

        <div class="flex flex-col md:flex-row items-center justify-around gap-6 pb-6 border-b border-slate-200">
          <!-- Lingkaran Skor Akhir -->
          <div class="text-center">
            <div class="w-36 h-36 rounded-full border-8 border-indigo-100 bg-indigo-50/50 flex flex-col items-center justify-center mx-auto shadow-inner">
              <span class="text-xs font-bold uppercase tracking-wider text-indigo-600">Skor Akhir</span>
              <span id="result-score" class="text-4xl font-black text-slate-900 mt-0.5">0</span>
            </div>
            <span id="result-predicate" class="inline-block mt-3 px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800">Sangat Baik</span>
          </div>

          <!-- Statistik Benar / Salah / Kosong -->
          <div class="grid grid-cols-3 gap-3 sm:gap-5 w-full md:w-auto">
            <div class="bg-emerald-50 border border-emerald-200 rounded-2xl p-4 text-center">
              <span class="text-2xl sm:text-3xl font-extrabold text-emerald-700 block" id="result-correct">0</span>
