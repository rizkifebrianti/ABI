        return this.results.filter((r) => r.packageId === filterVal);
      }

      renderScoresTable() {
        const filtered = this.getFilteredResults();
        const summaryEl = document.getElementById('scores-summary-cards');
        const tbody = document.getElementById('scores-table-body');
        if (!tbody) return;

        const totalAttempt = filtered.length;
        const avgScore =
          totalAttempt > 0
            ? Math.round(filtered.reduce((acc, item) => acc + Number(item.score || 0), 0) / totalAttempt)
            : 0;
        const bannedCount = filtered.filter((item) => item.isBanned || (item.violationCount || 0) >= 3).length;

        if (summaryEl) {
          summaryEl.innerHTML = `
            <div class="bg-slate-50 rounded-xl p-4 border border-slate-200">
              <span class="text-xs text-slate-500 block">Total Pengerjaan</span>
              <strong class="text-xl font-extrabold text-slate-900">${totalAttempt} Siswa</strong>
            </div>
            <div class="bg-indigo-50/70 rounded-xl p-4 border border-indigo-200">
              <span class="text-xs text-indigo-700 block">Rata-rata Skor</span>
              <strong class="text-xl font-extrabold text-indigo-900">${avgScore} / 100</strong>
            </div>
            <div class="bg-rose-50/70 rounded-xl p-4 border border-rose-200">
              <span class="text-xs text-rose-700 block">Terkena Banned (3x Pelanggaran)</span>
              <strong class="text-xl font-extrabold text-rose-800">${bannedCount} Siswa</strong>
            </div>
          `;
        }

