      renderPortal() {
        const categories = ['Semua', 'SMP', 'SMA', 'UTBK / SNBT', 'Kedinasan / CPNS'];
        const filterContainer = document.getElementById('portal-category-filters');
        if (filterContainer) {
          filterContainer.innerHTML = categories
            .map((cat) => {
              const active = this.portalCategory === cat;
              return `
                <button
                  type="button"
                  onclick="app.setPortalCategory('${cat}')"
                  class="px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold transition ${
                    active
                      ? 'bg-indigo-600 text-white shadow-2xs'
                      : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
                  }"
                >
                  ${escapeHtmlText(cat)}
                </button>
              `;
            })
            .join('');
        }

        // HANYA tampilkan paket soal berstatus "Published"
        const publishedPackages = this.packages.filter((pkg) => {
          if (pkg.status !== 'Published') return false;
          const matchCat = this.portalCategory === 'Semua' || pkg.category === this.portalCategory;
          const matchSearch =
            !this.portalSearch ||
            (pkg.title || '').toLowerCase().includes(this.portalSearch) ||
            (pkg.category || '').toLowerCase().includes(this.portalSearch);
          return matchCat && matchSearch;
        });

        const countLabel = document.getElementById('portal-count-label');
        if (countLabel) countLabel.textContent = publishedPackages.length;

        const grid = document.getElementById('portal-packages-grid');
