                  Batal
                </button>
                <button type="submit" class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-bold shadow-xs transition">
                  Simpan Paket
                </button>
              </div>
            </form>
          </div>
        `);
